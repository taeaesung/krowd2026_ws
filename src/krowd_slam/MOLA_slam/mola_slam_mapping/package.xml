<?xml version="1.0"?>
<package format="3">
  <name>mola_slam_mapping</name>
  <version>0.1.0</version>
  <description>Pre-race LiDAR+IMU+GNSS+wheel-odometry mapping launch and 1m waypoint-saving node, built on the MOLA SLAM stack.</description>
  <maintainer email="krowd2026@gmail.com">krowd</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>krowd_lidar_odometry</exec_depend>
  <exec_depend>mola_bridge_ros2</exec_depend>
  <exec_depend>mola_launcher</exec_depend>
  <exec_depend>mola_lidar_odometry</exec_depend>
  <exec_depend>mola_state_estimation_smoother</exec_depend>
  <exec_depend>mrpt_nav_interfaces</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros_can_bridge_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
