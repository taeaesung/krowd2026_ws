# Traffic-light detection zones for THIS map.
# Map: 20260913_103732_repaired (route start extended 20 m on 2026-10-22, all idx +19) - waypoints #0 to #627 (628 of them, ~1 m apart).
# The numbers are waypoints.csv's `idx` column, i.e. the "#170"
# labels RViz draws next to the purple waypoint dots.
#
# Each entry is an inclusive "first-last" range, e.g. ["170-180",
# "250-260"]. Inside one, the route corridor is drawn red and
# localization_monitor_node publishes true on /traffic_detect_space.
#
# This file belongs to this map alone - another mapping run renumbers
# the waypoints. localization.launch.py reads it automatically when
# localizing against this folder; no launch argument needed.
localization_monitor_node:
  ros__parameters:
    traffic_detect_zones: ["83-87", "127-135", "257-258", "312-315", "401-405"]
# 2026-10-25: 257-261 -> 257-258 (정지선에서 신호등이 카메라 위로 빠짐, 약 4 m 앞 정지)
